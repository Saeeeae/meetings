APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/meeting_minutes
REDIS_URL=redis://redis:6379/0

STORAGE_DIR=/data/storage
MODELS_DIR=/models
MAX_UPLOAD_SIZE_MB=2048

STT_PROVIDER=qwen_asr
STT_LANGUAGE=ko
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=auto
FASTER_WHISPER_COMPUTE_TYPE=int8
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ASR_FORCED_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
QWEN_ASR_DTYPE=bfloat16
QWEN_ASR_DEVICE_MAP=cuda:0
QWEN_ASR_MAX_INFERENCE_BATCH_SIZE=8
QWEN_ASR_MAX_NEW_TOKENS=4096
QWEN_ASR_RETURN_TIMESTAMPS=true

DIARIZATION_PROVIDER=mock
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

GPU_STAGE_SUBPROCESS=true
GPU_STAGE_TIMEOUT_SECONDS=7200

VLLM_ON_DEMAND=false
VLLM_MODEL=
VLLM_HOST=127.0.0.1
VLLM_PORT=8001
VLLM_STARTUP_TIMEOUT_SECONDS=900
VLLM_SHUTDOWN_TIMEOUT_SECONDS=60
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_DTYPE=auto
VLLM_MAX_MODEL_LEN=
VLLM_TRUST_REMOTE_CODE=false
VLLM_EXTRA_ARGS=
VLLM_COMMAND=
VLLM_REUSE_EXISTING=true

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
