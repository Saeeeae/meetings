APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/meeting_minutes
REDIS_URL=redis://redis:6379/0

STORAGE_DIR=/data/storage
MODELS_DIR=/models
MAX_UPLOAD_SIZE_MB=2048
CLEANUP_UPLOADS_ON_SUCCESS=true
# 처리된 16kHz WAV을 보존하면 결과 화면에서 오디오 미리듣기/세그먼트 seek 사용 가능
CLEANUP_PROCESSED_ON_SUCCESS=false
# N일 경과한 completed/failed job의 오디오 파일 자동 삭제 (0 이면 사용 안 함)
RETENTION_DAYS=14
# 모든 /api/* 요청에 'X-API-Key' 또는 '?api_key=' 검사 (비워두면 인증 없음)
API_KEY=

# === 오디오 전처리 ===
# 음량 정규화 (-16 LUFS). 잡음 추가 없이 STT 안정성 향상. 기본 활성화 권장.
AUDIO_LOUDNESS_NORMALIZE=true
# 저주파 컷오프(Hz). AC 험/마이크 럼블 제거. 비워두면 비활성화.
AUDIO_HIGHPASS_HZ=80
# 신경망 기반 잡음 감쇄(afftdn). 한국어 자음(ㅅ/ㅊ) 손상 가능성 있어 기본 비활성화.
AUDIO_DENOISE=false
# AUDIO_DENOISE=true일 때 감쇄 강도(dB). 10~30 권장.
AUDIO_DENOISE_STRENGTH_DB=20

STT_PROVIDER=qwen_asr
STT_LANGUAGE=ko
# 콤마/줄바꿈으로 구분한 STT 힌트 단어 (회사명, 임원 이름, 사내 약어 등)
STT_CONTEXT=
# JSON은 {"오인식": "표준어"}, 일반 텍스트는 표준어 한 줄 또는 오인식<TAB>표준어
LEXICON_PATH=config/stt_dictionary.json
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ASR_FORCED_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
QWEN_ASR_DTYPE=bfloat16
QWEN_ASR_DEVICE_MAP=cuda:0
QWEN_ASR_MAX_INFERENCE_BATCH_SIZE=8
QWEN_ASR_MAX_NEW_TOKENS=4096
QWEN_ASR_RETURN_TIMESTAMPS=true

DIARIZATION_PROVIDER=mock
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
# 참석자 수 힌트(정확히 알면 PYANNOTE_NUM_SPEAKERS, 범위만 알면 min/max)
PYANNOTE_NUM_SPEAKERS=
PYANNOTE_MIN_SPEAKERS=
PYANNOTE_MAX_SPEAKERS=
HUGGINGFACE_TOKEN=

LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_INPUT_CHARS=12000
LLM_REQUEST_TIMEOUT_SECONDS=600

GPU_STAGE_SUBPROCESS=true
GPU_STAGE_TIMEOUT_SECONDS=7200
# job 전체 처리 시간 상한(초). Redis visibility timeout도 이 값 기준으로 설정됨
JOB_TIME_LIMIT_SECONDS=21600
# worker 재시작 시 queued/processing 작업을 자동으로 다시 큐에 등록
RECOVER_INTERRUPTED_JOBS=true

VLLM_ON_DEMAND=false
VLLM_MODEL=
VLLM_HOST=127.0.0.1
VLLM_PORT=8001
VLLM_STARTUP_TIMEOUT_SECONDS=900
VLLM_SHUTDOWN_TIMEOUT_SECONDS=60
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_DTYPE=auto
VLLM_MAX_MODEL_LEN=
VLLM_TRUST_REMOTE_CODE=false
VLLM_EXTRA_ARGS=
VLLM_COMMAND=
VLLM_REUSE_EXISTING=true
# true 면 작업 간 vLLM 서버를 살려둬서 매 job 기동 비용을 제거 (단일 GPU에서 STT/diar과 VRAM 충돌 주의)
VLLM_WARM_KEEP=false
VLLM_LOG_RETENTION=10

# --- 폐쇄망(air-gap) 운영 시 권장 ---
# 모델을 models/ 폴더에 모두 반입한 뒤 아래 주석을 해제하면
# Hugging Face 라이브러리의 외부 네트워크 시도(버전 확인 등)를 차단합니다.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
